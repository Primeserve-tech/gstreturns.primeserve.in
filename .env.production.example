CI_ENVIRONMENT=production
app.baseURL=https://gstreturns.primeserve.in/
app.forceGlobalSecureRequests=true
cookie.secure=true
GST_MODE=live
GST_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
GST_ADMIN_USERNAME=admin
GST_ADMIN_PASSWORD_HASH=REPLACE_WITH_PASSWORD_HASH
GST_AUDIT_RETENTION_DAYS=30
# Exact trusted Coolify proxy IPs/CIDRs only; forwarded headers are ignored if blank.
GST_TRUSTED_PROXIES=
GST_POLL_SECONDS=10
GST_JOB_TIMEOUT_SECONDS=540
GST_POLL_MAX_ERRORS=4
GST_TEMP_DIR=/run/returns-temp
