# Merge names into secure server configuration; never replace the existing .env or encryption key.
GST_CUSTOMERS_ENABLED = 1
# Enable only after staging acceptance, real email and billing/security tests pass.
GST_BILLING_VERIFIED = 0
GST_PUBLIC_URL = 'https://gstreturns.primeserve.in'
ZOHO_CPAAS_HOST = 'https://cpaas.zoho.in'
ZOHO_CPAAS_AGENT_ALIAS = ''
# Actual Agent send-mail token, optionally including its Zoho-enczapikey prefix. Not a DKIM key.
ZOHO_CPAAS_API_KEY = ''
# Must be an existing verified sender on primeserve.in. No default address is invented.
ZOHO_CPAAS_FROM = ''
