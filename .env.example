CI_ENVIRONMENT = production
app.baseURL = 'http://127.0.0.1:8085/'
app.forceGlobalSecureRequests = false
cookie.secure = false
# Set both flags above to true for HTTPS deployment.
GST_MODE = disabled
# disabled: no API activity; fixture: localhost-only synthetic workflow; live: verified contract required.
# Generate once with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Keep this key stable and backed up securely. Never commit the populated .env file.
GST_ENCRYPTION_KEY = ''
GST_POLL_SECONDS = 10
GST_JOB_TIMEOUT_SECONDS = 540
GST_POLL_MAX_ERRORS = 4
GST_AUDIT_RETENTION_DAYS = 30
GST_ADMIN_USERNAME = admin
GST_ADMIN_PASSWORD_HASH = ''
GST_TRUSTED_PROXIES = ''
# Return jobs and temporary ZIPs always expire after 600 seconds.
